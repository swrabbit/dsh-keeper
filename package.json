{
  "name": "dsh-keeper-plugin",
  "version": "0.1.5",
  "description": "DSH Keeper — manage DSH workspace sessions, plugins, sidebar entries, and notifications in one place. DSH 管家：集中管理 DSH 的会话、插件、侧栏入口与通知。",
  "icon": "icon.svg",
  "type": "module",
  "main": "index.js",
  "author": "supaleyer <wl94011@163.com>",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swrabbit/dsh-keeper.git"
  },
  "homepage": "https://github.com/swrabbit/dsh-keeper#readme",
  "bugs": {
    "url": "https://github.com/swrabbit/dsh-keeper/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "keeper",
    "sessions",
    "plugins",
    "notifications",
    "workspace",
    "sidebar"
  ],
  "engines": {
    "node": ">=22.15",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE"
  ]
}
